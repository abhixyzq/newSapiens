# ---- Core ----
ENV=development                      # development | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars   # REQUIRED in production (app refuses to start with the default)
DATABASE_URL=sqlite:///./newsapiens.db
# Production:  postgresql+psycopg://user:pass@host:5432/newsapiens   (needs the pgvector extension)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                  # true behind HTTPS
REGISTER_ENABLED=true                # false once your account exists (single-user deployments)
API_TOKEN=                           # static bearer token for POST /api/process (wearable app); endpoint is disabled while empty

# ---- Storage (private audio; served only via short-lived signed URLs) ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500
SIGNED_URL_TTL_SECONDS=900

# ---- Background jobs ----
JOB_BACKEND=thread                   # thread | inline (tests)
SCHEDULER_ENABLED=true               # daily report generation + retention purge + stuck-job recovery

# ---- Speech-to-text ----
STT_PROVIDER=none                    # none | openai | gemini | deepgram | faster_whisper
STT_MODEL=whisper-1                  # openai: whisper-1 ; faster_whisper: e.g. small / medium / large-v3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=                      # STT_PROVIDER=gemini (audio <= 18MB)
GEMINI_STT_MODEL=gemini-2.5-flash
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---- LLM (extraction + grounded answers) ----
LLM_PROVIDER=rule_based              # rule_based | openai (any OpenAI-compatible endpoint) | anthropic
LLM_MODEL=                           # required when LLM_PROVIDER != rule_based
LLM_BASE_URL=                        # optional override for openai-compatible servers
ANTHROPIC_API_KEY=

# ---- Embeddings ----
EMBEDDING_PROVIDER=hash              # hash (local, no key, weak) | openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256                    # hash: 256 ; text-embedding-3-small: 1536

# ---- Limits ----
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- PDF ----
PDF_FONT_PATH=                       # optional TTF with wide Unicode coverage
